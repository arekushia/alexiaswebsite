# Copy this file to .env (local dev, or uploaded via SFTP in production). Never commit .env.

# Local port only; the hosting platform provides PORT itself.
PORT=3000

# SMTP server used to send the contact e-mails.
SMTP_HOST=
SMTP_PORT=25
# Leave SMTP_USER / SMTP_PASS empty if the server does not require authentication.
SMTP_USER=
SMTP_PASS=

# Sender must be an address on your own domain; MAIL_TO receives the messages.
MAIL_FROM=
MAIL_TO=
